# ─────────────────────────────────────────────────────────────────────────────
# TruthLayer Render Production Environment File (.env.render)
#
# Paste these key=value pairs directly into Render Dashboard:
# Render Dashboard → Service (truthlayer-backend) → Environment → Add Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Core & Production Configuration ──────────────────────────────────────────
ENVIRONMENT=production
USE_CELERY=false
BACKEND_CORS_ORIGINS=https://truthlayer-ashen.vercel.app,http://localhost:3000
BACKEND_PUBLIC_URL=https://truthlayer-backend-spcp.onrender.com

# ── Models & AI Engine (OpenRouter) ──────────────────────────────────────────
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash-lite
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_MODEL=openai/text-embedding-3-small
EMBEDDINGS_DIM=1536
TRANSCRIPTION_PROVIDER=openrouter
TRANSCRIPTION_MODEL=google/gemini-2.5-flash-lite

# ── Media Storage ────────────────────────────────────────────────────────────
MEDIA_STORAGE_DIR=/tmp/truthlayer/media
MAX_UPLOAD_MB=200
MAX_DOCUMENT_MB=25

# ── Database & Auth (Fill in your Supabase credentials below) ───────────────
# Replace <your-project-ref> and <your-db-password> with your actual Supabase details:
SUPABASE_URL=https://<your-project-ref>.supabase.co
DATABASE_URL=postgresql+psycopg://postgres.<your-project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ── Secret Encryption Key ────────────────────────────────────────────────────
# Must be a 32-byte URL-safe base64 string. Generate using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-your-32-byte-fernet-key

# ── yt-dlp Anti-Bot (Optional: Render Secret File) ──────────────────────────
# Point to your uploaded cookies.txt secret file path if using cookies on Render
YTDLP_COOKIES_FILE=/etc/secrets/cookies.txt
YTDLP_PROXY=
