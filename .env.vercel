# ─────────────────────────────────────────────────────────────────────────────
# TruthLayer Vercel Production Environment File (.env.vercel)
#
# Paste these environment variables into Vercel Dashboard:
# Vercel Dashboard → Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Render Backend API Endpoint
NEXT_PUBLIC_API_URL=https://truthlayer-backend-spcp.onrender.com

# Supabase Client Credentials (Fill in your Supabase details below)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
